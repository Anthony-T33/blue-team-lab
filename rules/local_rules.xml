<!-- Local rules - Home Security Lab custom detection rules (Phase 2) -->

<group name="lab_custom,">

  <rule id="100100" level="10" frequency="6" timeframe="120" ignore="60">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>BRUTE-FORCE: 6+ failed SSH logins (non-existent user) in 120s from the same source IP.</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,bruteforce,lab,</group>
  </rule>

  <rule id="100200" level="9">
    <if_sid>550</if_sid>
    <match>^File '/etc/</match>
    <description>INTEGRITY: File modified under /etc (possible tampering or persistence).</description>
    <mitre>
      <id>T1565</id>
    </mitre>
    <group>syscheck,fim,lab,</group>
  </rule>

  <rule id="100300" level="12">
    <match>/tmp/.malware</match>
    <description>MALWARE: Suspicious process detected (backdoor binary in hidden /tmp/.malware).</description>
    <mitre>
      <id>T1059</id>
    </mitre>
    <group>malware,suspicious_process,lab,</group>
  </rule>

</group>
